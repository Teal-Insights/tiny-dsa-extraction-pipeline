# Logging verbosity for pipeline entry points (default: INFO)
LOG_LEVEL=INFO

# Provider API keys (set the key for whichever model family you use)
OPENAI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Document stage uses the Cursor SDK (local agent against dist/)
CURSOR_API_KEY=

# Per-stage model selection (optional; defaults to gpt-5.5 when unset)
# Name prefix selects the provider: gpt-*, glm-*, deepseek-*
# Annotate stage (inverted-tree docstrings)
DOCSTRING_MODEL=gpt-5.5
# Dormant until issue #55 (ctx Pass-1 / Pass-2 internals refactor). Not a live pipeline knob.
# REFACTOR_MODEL=gpt-5.5
# Document-stage Cursor agent
DOCUMENT_AGENT_MODEL=gpt-5.6-luna
# Opt-in graph dependency audits (pytest --run-skipped)
LLM_GRAPH_AUDIT_MODEL=gpt-5.5
# How many auto-selected / declared parents to audit per run (default: 5)
# LLM_GRAPH_AUDIT_CASES=5
# Seed for difficulty-ranked sampling (default: 0)
# LLM_GRAPH_AUDIT_SEED=0

# Max in-flight async LLM requests per process (default: 5; set to 1 for serial debugging)
# LLM_MAX_CONCURRENT=5

# DeepSeek thinking mode (optional; disabled by default)
# DEEPSEEK_THINKING=1
